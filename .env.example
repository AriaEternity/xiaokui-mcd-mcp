# 示例文件不会自动加载。请通过你自己的进程管理器设置环境变量。
PUBLIC_ORIGIN=https://mcd.example.com
DATA_ROOT=/var/lib/xiaokui-mcd
PORT=4318
MCP_OAUTH_ENABLED=true
MCD_MCP_ENABLED=true
# 必须替换为宿主会话实际返回的、不公开的 ownerId。
MCD_OWNER_ID=replace-with-your-owner-id
# 默认关闭；先核验只读和计价，再由部署者显式开启。
MCD_ORDER_CREATE_ENABLED=false
# 独立凭据目录内只放 mcd-token；不在环境变量中填写 Token 正文。
MCD_CREDENTIAL_ROOT=/run/credentials/xiaokui-mcd.service
# 管理员自己提供的本地宿主登录适配模块；绝不使用测试假会话。
OWNER_AUTH_ADAPTER=/opt/xiaokui-mcd/owner-auth.mjs
