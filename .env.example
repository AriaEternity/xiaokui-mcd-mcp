# 示例文件不会自动加载。请通过你自己的进程管理器设置环境变量。
PUBLIC_ORIGIN=https://mcd.example.com
DATA_ROOT=/var/lib/xiaokui-mcd
PORT=4318
MCP_OAUTH_ENABLED=true
MCD_MCP_ENABLED=true
# standalone 从私有主人文件获取身份；不要自己填写/分享 ownerId。
# systemd模板同时使用LoadCredential装入owner.json与mcd-token。
# 默认关闭；先核验只读和计价，再由部署者显式开启。
MCD_ORDER_CREATE_ENABLED=false
# 独立凭据目录内只放 mcd-token；不在环境变量中填写 Token 正文。
# 非systemd本地运行才指定受限文件路径：
# OWNER_FILE=/absolute/private/owner.json
# MCD_CREDENTIAL_ROOT=/absolute/private/credentials
# 高级宿主集成才使用以下两项，并运行 npm run start:host：
# MCD_OWNER_ID=your-existing-host-owner-id
# OWNER_AUTH_ADAPTER=/absolute/private/owner-auth.mjs
