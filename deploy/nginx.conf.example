# 放进你自己的 HTTPS server 块；TLS、域名和证书由已有站点负责。
# 不得覆盖其他应用已有的 OAuth well-known 或登录路由。
location ~ ^/(api/mcd/|\.well-known/oauth-authorization-server$|\.well-known/oauth-protected-resource(?:/api/mcd/orders/mcp)?$) {
    proxy_pass http://127.0.0.1:4318;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 35s;
    client_max_body_size 32k;
    access_log off;
    add_header Referrer-Policy no-referrer always;
}

# 仅用于独立域名、由示例宿主提供登录接口的部署。
# 已有登录系统的站点保留它自己的安全配置。
location /api/v1/auth/ {
    proxy_pass http://127.0.0.1:4318;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    client_max_body_size 8k;
    access_log off;
    add_header Cache-Control no-store always;
}
