# 独立单主人模式。先创建专属用户、初始化owner.json并保存官方凭据。
[Unit]
Description=Xiaokui McDonald MCP gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xiaokui-mcd
Group=xiaokui-mcd
WorkingDirectory=/opt/xiaokui-mcd/current
ExecStart=/opt/node-v24.20.0-linux-x64/bin/node /opt/xiaokui-mcd/current/dist/main.js
EnvironmentFile=/etc/xiaokui-mcd/bridge.env
LoadCredential=mcd-token:/etc/xiaokui-mcd/mcd-token
LoadCredential=owner.json:/etc/xiaokui-mcd/owner.json
StateDirectory=xiaokui-mcd
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
LimitCORE=0
ReadWritePaths=/var/lib/xiaokui-mcd
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
